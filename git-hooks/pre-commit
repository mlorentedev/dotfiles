#!/usr/bin/env bash
#
# Global pre-commit dispatcher (GUARD-001). Installed machine-wide via
# core.hooksPath, so it runs in EVERY repo. It (1) runs the memory-sink guard,
# then (2) chains to the repo-local hook — because a global core.hooksPath makes
# git ignore .git/hooks/, this exec is what keeps per-repo guards (gitleaks)
# alive. See ADR / spec GUARD-001 (R1: multi-hook chaining dispatcher).

set -u

DISPATCH_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

# 1. Global concern: block memory artifacts outside the vault.
"$DISPATCH_DIR/lib/memory-sink-guard.sh" || exit $?

# 2. Scoped lane guard: enforce persistent named lanes in .dotf/lanes.json repos (HARNESS-186).
#    The guard is POSIX sh by contract, so invoke it with sh — not bash — to keep it
#    portable to hosts without bash and to fail loudly if a bashism is reintroduced.
if [ -f "$DISPATCH_DIR/lib/lane-guard.sh" ]; then
  sh "$DISPATCH_DIR/lib/lane-guard.sh" || exit $?
fi

# 3. Chain to the repo-local hook (shadowed by the global core.hooksPath).
exec "$DISPATCH_DIR/lib/chain-local-hook.sh" pre-commit "$@"
