# Dockerfile.integration - Container-based integration test for setup-linux.sh
# Builds a clean Ubuntu environment, runs the full bootstrap, then verifies side effects.
#
# Usage:
#   source versions.conf
#   docker build --build-arg BATS_VERSION=$BATS_VERSION \
#     -f tests/Dockerfile.integration -t dotfiles-integration-test .
#   docker run --rm dotfiles-integration-test

FROM ubuntu:26.04

ARG BATS_VERSION=1.13.0
ARG AGE_VERSION=1.3.1
# Go toolchain for building dotf from THIS tree (default mirrors cli/go.mod's
# `go` directive; ci.yml passes the real value as a build-arg).
ARG GO_VERSION=1.26.0

# Minimal dependencies that setup-linux.sh actually needs. xz-utils extracts
# .tar.xz archives: without it a `tar xJf` failed silently with "tar (child): xz:
# Cannot exec". shellcheck, its first user, now comes from mise (#2013 W2). A
# standard Ubuntu desktop ships xz-utils, so the container keeps it to stay
# representative of a real machine.
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    zsh \
    git \
    curl \
    sed \
    grep \
    coreutils \
    ca-certificates \
    tmux \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Install pinned age binary (honours AGE_VERSION from versions.conf, #1060)
RUN curl -fsSL --retry 3 --retry-all-errors "https://github.com/FiloSottile/age/releases/download/v${AGE_VERSION}/age-v${AGE_VERSION}-linux-amd64.tar.gz" -o /tmp/age.tar.gz \
    && tar -xzf /tmp/age.tar.gz -C /tmp \
    && cp /tmp/age/age /tmp/age/age-keygen /usr/local/bin/ \
    && rm -rf /tmp/age.tar.gz /tmp/age

# Install bats-core from source
RUN curl -fsSL --retry 3 --retry-all-errors "https://github.com/bats-core/bats-core/archive/refs/tags/v${BATS_VERSION}.tar.gz" -o /tmp/bats.tar.gz \
    && tar -xzf /tmp/bats.tar.gz -C /tmp \
    && /tmp/bats-core-${BATS_VERSION}/install.sh /usr/local \
    && rm -rf /tmp/bats.tar.gz /tmp/bats-core-${BATS_VERSION}

# Go, for building dotf from the tree under test. The released dotf lags the
# tree: setup-linux.sh's install_dotf downloaded 0.51.0 here, which had no
# `harness mirror`, so the integration job tested the last release and failed
# on the PR that added the command (#1305). Same principle as the Windows job
# (TEST-003, #1298): CI certifies the PR's binary, not the previous one's.
RUN curl -fsSL --retry 3 --retry-all-errors "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o /tmp/go.tar.gz \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm -f /tmp/go.tar.gz
ENV PATH="/usr/local/go/bin:${PATH}"

# Node from apt, installed as root: npm's global prefix is then /usr, which
# testuser cannot write. That is a real box without nvm loaded. Without Node the
# npm catalog (bw, yarn, opencode, copilot) skipped here, so a `dotf tools
# install` running a bare `npm install -g` passed every job and failed with
# EACCES on the first machine that ran it (#2251).
RUN apt-get update && apt-get install -y --no-install-recommends nodejs npm \
    && rm -rf /var/lib/apt/lists/*

# Non-root user (setup-linux.sh uses $HOME)
RUN useradd -m -s /bin/bash testuser
USER testuser
WORKDIR /home/testuser

# Generate age key so dotf secrets / deploy-time substitution can decrypt
RUN mkdir -p /home/testuser/.config/age \
    && age-keygen -o /home/testuser/.config/age/key.txt 2>/dev/null

# Copy repo to ~/dotfiles-repo (NOT ~/.dotfiles) to trigger the copy branch
COPY --chown=testuser:testuser . /home/testuser/dotfiles-repo

# Built from a linked worktree, the copied .git is a file naming a gitdir on the
# host that does not exist here, so every git call in the repo exits 128 and
# five verify-setup tests fail falsely (#2253). Such a build gets a one-commit
# repository of the copied tree, the shape of CI's depth-1 checkout. A build
# from a full clone, as in CI, keeps its real .git directory untouched.
RUN cd /home/testuser/dotfiles-repo \
    && if [ -f .git ]; then \
        rm .git \
        && git init -q -b main \
        && git add -A \
        && git -c user.name=integration -c user.email=integration@localhost \
            commit -q -m "integration snapshot of a worktree build"; \
    fi

# dotf from this tree, where install_dotf places the release. It reports
# `dev`, and install_dotf leaves a dev build in place (a DOTF_VERSION env
# override cannot express this: setup-linux.sh sources versions.conf, which
# sets DOTF_VERSION back to the pin).
RUN mkdir -p /home/testuser/.local/bin \
    && cd /home/testuser/dotfiles-repo/cli \
    && go build -o /home/testuser/.local/bin/dotf ./cmd/dotf \
    && /home/testuser/.local/bin/dotf version

# agy, installed before setup the way bats is above, so setup-linux.sh finds it
# and reports "already installed". Its own install is a vendor `curl | bash` that
# warns and continues on failure; when it failed fast on the first run, the
# second run installed agy, `dotf harness bind` then wrote
# ~/.gemini/config/hooks.json, and the idempotence test read that repair as
# drift (#1704). Here a vendor outage fails the build at this step, by name.
# The retry wraps the whole install: the installer makes its own downloads, which
# a `curl --retry` on the outer fetch would not cover. It is fetched to a file
# rather than piped, because `sh` has no pipefail and `bash` reading an empty
# pipe from a failed curl exits 0.
RUN for attempt in 1 2 3 4 5; do \
        curl -fsSL --retry 3 --retry-all-errors https://antigravity.google/cli/install.sh -o /tmp/agy-install.sh \
            && bash /tmp/agy-install.sh \
            && test -x /home/testuser/.local/bin/agy \
            && break; \
        [ "$attempt" -eq 5 ] && break; \
        echo "agy install attempt $attempt failed; retrying in $((attempt * 5))s" >&2; \
        sleep $((attempt * 5)); \
    done \
    && rm -f /tmp/agy-install.sh \
    && test -x /home/testuser/.local/bin/agy

# Marker for verify-setup.bats to detect it's running inside the container
ENV DOTFILES_INTEGRATION_TEST=1

# Run setup — if this fails, the build fails (first verification layer)
RUN cd /home/testuser/dotfiles-repo && bash setup-linux.sh

# Second verification layer: bats assertions
ENTRYPOINT ["bats", "/home/testuser/dotfiles-repo/tests/verify-setup.bats"]
