# --- KUBELAB-SSH-START ---
# Primary: Headscale VPN (works from anywhere — requires a native Tailscale node)
# Fallback: LAN aliases (*-lan) for when VPN is down and on local network
# Bastion: *-ext aliases jump via VPS public IP — for non-admin boxes that can't
#          run native Tailscale, so mesh IPs (100.64.0.x) aren't locally routable

# --- VPN access (Headscale mesh) ---
Host rpi4
  Hostname 100.64.0.10
  User manu
  IdentityFile ~/.ssh/id_ed25519

Host rpi3
  Hostname 100.64.0.6
  User manu
  IdentityFile ~/.ssh/id_ed25519

Host ace1
  Hostname 100.64.0.11
  User manu
  IdentityFile ~/.ssh/id_ed25519

Host ace2
  Hostname 100.64.0.5
  User manu
  IdentityFile ~/.ssh/id_ed25519

Host bee
  Hostname 100.64.0.3
  User manu
  IdentityFile ~/.ssh/id_ed25519

Host jet1
  Hostname 100.64.0.8
  User manu
  IdentityFile ~/.ssh/id_ed25519

# The Argo CD hub. NAME, never a mesh IP: a MIG recreate rotates it
# (.21 -> .24 -> .12 -> .13 across August 2026), so a pinned address is stale
# from the next recreate onward. MagicDNS tracks it.
Host gcp1
  Hostname gcp1.kubelab.internal
  User deployer
  IdentityFile ~/.ssh/id_ed25519

Host vps
  Hostname 100.64.0.2
  User deployer
  UserKnownHostsFile ~/.ssh/known_hosts_pinned
  StrictHostKeyChecking yes
  IdentityFile ~/.ssh/id_ed25519

# --- Workstations (remote development targets) ---
# Tailnet only, by decision: no *-lan and no *-ext alias. Their sshd accepts
# 100.64.0.0/10 and nothing else, so an alias through the LAN or the public
# bastion would only fail. Names, not mesh IPs: MagicDNS follows a node that
# re-registers. Onboarding: docs/runbooks/guide-workstation-ssh-target.md
# Their host keys are pinned (ssh/known_hosts): any other key is refused.
Host msi
  Hostname msi.kubelab.internal
  User manu
  UserKnownHostsFile ~/.ssh/known_hosts_pinned
  StrictHostKeyChecking yes
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  ServerAliveInterval 30
  ServerAliveCountMax 3
  ForwardAgent no

Host macmini
  Hostname macmini.kubelab.internal
  User manu
  UserKnownHostsFile ~/.ssh/known_hosts_pinned
  StrictHostKeyChecking yes
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  ServerAliveInterval 30
  ServerAliveCountMax 3
  ForwardAgent no

# --- LAN fallback (no VPN needed, local network only) ---
Host rpi4-lan
  Hostname 10.0.0.131
  User manu
  IdentityFile ~/.ssh/id_ed25519

Host rpi3-lan
  Hostname 10.0.0.157
  User manu
  IdentityFile ~/.ssh/id_ed25519

Host ace1-lan
  Hostname 172.16.1.2
  User manu
  IdentityFile ~/.ssh/id_ed25519
  ProxyJump rpi4-lan

Host ace2-lan
  Hostname 172.16.1.5
  User manu
  IdentityFile ~/.ssh/id_ed25519
  ProxyJump rpi4-lan

Host bee-lan
  Hostname 172.16.1.3
  User manu
  IdentityFile ~/.ssh/id_ed25519
  ProxyJump rpi4-lan

Host jet1-lan
  Hostname 172.16.1.4
  User manu
  IdentityFile ~/.ssh/id_ed25519
  ProxyJump rpi4-lan

# No hub-pub alias: the GCP hub has no static public address to pin, and its
# bootstrap access is `gcloud compute ssh` against the MIG's current instance.

Host vps-pub
  Hostname 162.55.57.175
  User deployer
  UserKnownHostsFile ~/.ssh/known_hosts_pinned
  StrictHostKeyChecking yes
  IdentityFile ~/.ssh/id_ed25519

# --- Bastion access (*-ext): jump via VPS public IP. Use from outside the LAN on
#     a box without native Tailscale (mesh IPs not locally routable there). The VPS
#     (vps-pub) is always reachable by public IP and is itself on the mesh. ---
Host rpi4-ext
  Hostname 100.64.0.10
  User manu
  IdentityFile ~/.ssh/id_ed25519
  ProxyJump vps-pub

Host rpi3-ext
  Hostname 100.64.0.6
  User manu
  IdentityFile ~/.ssh/id_ed25519
  ProxyJump vps-pub

Host ace1-ext
  Hostname 100.64.0.11
  User manu
  IdentityFile ~/.ssh/id_ed25519
  ProxyJump vps-pub

Host ace2-ext
  Hostname 100.64.0.5
  User manu
  IdentityFile ~/.ssh/id_ed25519
  ProxyJump vps-pub

Host bee-ext
  Hostname 100.64.0.3
  User manu
  IdentityFile ~/.ssh/id_ed25519
  ProxyJump vps-pub

Host jet1-ext
  Hostname 100.64.0.8
  User manu
  IdentityFile ~/.ssh/id_ed25519
  ProxyJump vps-pub

# Resolved on the bastion, which is itself on the mesh — so the name works here
# too, and survives the recreates that would strand a pinned address.
Host gcp1-ext
  Hostname gcp1.kubelab.internal
  User deployer
  IdentityFile ~/.ssh/id_ed25519
  ProxyJump vps-pub
# --- KUBELAB-SSH-END ---

# --- GITHUB-START ---
# Pinned to the key GitHub documents (ssh/known_hosts).
Host github.com
  UserKnownHostsFile ~/.ssh/known_hosts_pinned
  StrictHostKeyChecking yes
# --- GITHUB-END ---

# --- OFFICE-JETSON-START ---
Host jetson-office
    HostName ssh-pollex.mlorente.dev
    User manu
    ProxyCommand cloudflared access ssh --hostname %h
    IdentityFile ~/.ssh/id_ed25519
    ServerAliveInterval 15
    ServerAliveCountMax 3
# --- OFFICE-JETSON-END ---

# --- ACEMAGIC-OFFICE-START ---
Host acemagic-office
    HostName acemagic-office
    User manu
    IdentityFile ~/.ssh/id_ed25519_ts_bridge_acemagic
    IdentitiesOnly yes
    ServerAliveInterval 15
    ServerAliveCountMax 3
# --- ACEMAGIC-OFFICE-END ---

# --- AGENT-START ---
# Last, so every Host above keeps its own values: ssh takes the first one it
# reads for each keyword. The key goes into the agent on first use, and on
# macOS its passphrase comes from the login keychain, so a reboot never needs
# `ssh-add` again (#2013 PLAT-001b). UseKeychain exists only in Apple's
# OpenSSH; IgnoreUnknown keeps every other build, Linux and Windows included,
# from rejecting this whole file over it (tests/ssh-client-agent.bats).
Host *
    IgnoreUnknown UseKeychain
    AddKeysToAgent yes
    UseKeychain yes
# --- AGENT-END ---
