# --- KUBELAB-SSH-START ---
# Primary: Headscale VPN (works from anywhere — requires a native Tailscale node)
# Fallback: LAN aliases (*-lan) for when VPN is down and on local network
# Bastion: *-ext aliases jump via VPS public IP — for non-admin boxes that can't
#          run native Tailscale, so mesh IPs (100.64.0.x) aren't locally routable

# --- VPN access (Headscale mesh) ---
Host rpi4
  Hostname 100.64.0.10
  User manu
  IdentityFile ~/.ssh/id_ed25519

Host rpi3
  Hostname 100.64.0.6
  User manu
  IdentityFile ~/.ssh/id_ed25519

Host ace1
  Hostname 100.64.0.11
  User manu
  IdentityFile ~/.ssh/id_ed25519

Host ace2
  Hostname 100.64.0.5
  User manu
  IdentityFile ~/.ssh/id_ed25519

Host bee
  Hostname 100.64.0.3
  User manu
  IdentityFile ~/.ssh/id_ed25519

Host jet1
  Hostname 100.64.0.8
  User manu
  IdentityFile ~/.ssh/id_ed25519

Host aws1
  Hostname aws1.kubelab.internal
  User deployer
  IdentityFile ~/.ssh/id_ed25519

Host vps
  Hostname 100.64.0.2
  User deployer
  IdentityFile ~/.ssh/id_ed25519

# --- Fleet agents (Headscale tag:hermes, ADR-041; userspace pod, root) ---
Host hermes-nan
  Hostname 100.64.0.9
  User root
  IdentityFile ~/.ssh/id_ed25519

# --- LAN fallback (no VPN needed, local network only) ---
Host rpi4-lan
  Hostname 10.0.0.131
  User manu
  IdentityFile ~/.ssh/id_ed25519

Host rpi3-lan
  Hostname 10.0.0.157
  User manu
  IdentityFile ~/.ssh/id_ed25519

Host ace1-lan
  Hostname 172.16.1.2
  User manu
  IdentityFile ~/.ssh/id_ed25519
  ProxyJump rpi4-lan

Host ace2-lan
  Hostname 172.16.1.5
  User manu
  IdentityFile ~/.ssh/id_ed25519
  ProxyJump rpi4-lan

Host bee-lan
  Hostname 172.16.1.3
  User manu
  IdentityFile ~/.ssh/id_ed25519
  ProxyJump rpi4-lan

Host jet1-lan
  Hostname 172.16.1.4
  User manu
  IdentityFile ~/.ssh/id_ed25519
  ProxyJump rpi4-lan

# aws1-pub removed — use `terraform output public_ip` for bootstrap access

Host vps-pub
  Hostname 162.55.57.175
  User deployer
  IdentityFile ~/.ssh/id_ed25519

# --- Bastion access (*-ext): jump via VPS public IP. Use from outside the LAN on
#     a box without native Tailscale (mesh IPs not locally routable there). The VPS
#     (vps-pub) is always reachable by public IP and is itself on the mesh. ---
Host rpi4-ext
  Hostname 100.64.0.10
  User manu
  IdentityFile ~/.ssh/id_ed25519
  ProxyJump vps-pub

Host rpi3-ext
  Hostname 100.64.0.6
  User manu
  IdentityFile ~/.ssh/id_ed25519
  ProxyJump vps-pub

Host ace1-ext
  Hostname 100.64.0.11
  User manu
  IdentityFile ~/.ssh/id_ed25519
  ProxyJump vps-pub

Host ace2-ext
  Hostname 100.64.0.5
  User manu
  IdentityFile ~/.ssh/id_ed25519
  ProxyJump vps-pub

Host bee-ext
  Hostname 100.64.0.3
  User manu
  IdentityFile ~/.ssh/id_ed25519
  ProxyJump vps-pub

Host jet1-ext
  Hostname 100.64.0.8
  User manu
  IdentityFile ~/.ssh/id_ed25519
  ProxyJump vps-pub

Host aws1-ext
  Hostname 100.64.0.7
  User deployer
  IdentityFile ~/.ssh/id_ed25519
  ProxyJump vps-pub
# --- KUBELAB-SSH-END ---

# --- OFFICE-JETSON-START ---
Host jetson-office
    HostName ssh-pollex.mlorente.dev
    User manu
    ProxyCommand cloudflared access ssh --hostname %h
    IdentityFile ~/.ssh/id_ed25519
    ServerAliveInterval 15
    ServerAliveCountMax 3
# --- OFFICE-JETSON-END ---
