# EditorConfig — cross-IDE consistency (POLISH-004). https://editorconfig.org
# Governs NEW work in this repo; existing files are NOT reformatted (anti-scope).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Markdown: keep trailing whitespace (two trailing spaces = hard line break).
[*.{md,markdown}]
trim_trailing_whitespace = false

# Windows-native scripts: CRLF (PowerShell/cmd expect it).
[*.{ps1,psm1,psd1,bat,cmd}]
end_of_line = crlf

# Data/config files conventionally use 2-space indent.
[*.{yml,yaml,json,jsonc}]
indent_size = 2

# Tab-significant formats.
[Makefile]
indent_style = tab

[*.go]
indent_style = tab
