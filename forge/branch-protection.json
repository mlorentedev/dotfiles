{
  "$schema": "./branch-protection.schema.json",
  "$comment": [
    "Branch protection declared in git (GUARD-017, #1451). The first commit records the live state of 2026-09-23, so drift detection starts at zero; changes to it are deliberate edits that the diff shows.",
    "Check: `dotf forge protection check`, and the `dotf doctor` branch-protection section. Repositories with neither protection nor a specs/ tree are not managed here."
  ],
  "policy": {
    "required_approving_review_count": 0,
    "rationale": "Single maintainer. GitHub does not let an author approve their own pull request, and enforce_admins is true, so requiring one or more approvals would lock the only maintainer out of every merge. The human review gate is the owner's deliberate merge (never auto-merge), backed by the required review-attestation check (decision D-1, dotfiles#1625)."
  },
  "repos": {
    "mlorentedev/dotfiles": {
      "branch": "main",
      "protection": {
        "required_status_checks": {
          "strict": true,
          "checks": [
            {
              "context": "lint",
              "app_id": 15368
            },
            {
              "context": "lint-powershell",
              "app_id": 15368
            },
            {
              "context": "review-attestation",
              "app_id": 15368
            },
            {
              "context": "test",
              "app_id": 15368
            },
            {
              "context": "test-windows",
              "app_id": 15368
            }
          ]
        },
        "required_pull_request_reviews": {
          "required_approving_review_count": 0,
          "dismiss_stale_reviews": false,
          "require_code_owner_reviews": false,
          "require_last_push_approval": false
        },
        "enforce_admins": true,
        "required_signatures": false,
        "required_linear_history": false,
        "allow_force_pushes": false,
        "allow_deletions": false,
        "block_creations": false,
        "required_conversation_resolution": false,
        "lock_branch": false,
        "allow_fork_syncing": false
      }
    },
