#!/usr/bin/env bash
# =============================================================================
# Secrets Management Wrapper
# =============================================================================
# Enhanced wrapper around age encryption with safety features
# Features:
# - Auto-backup before changes
# - Integration with direnv
# - Pre-commit hooks validation
# - Easy encrypt/decrypt operations
# =============================================================================

set -e

# Source utils if available
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/utils" ]; then
    source "$SCRIPT_DIR/utils"
fi

# Configuration
AGE_KEY_FILE="${AGE_KEY_FILE:-$HOME/.config/age/key.txt}"
SECRETS_DIR="${SECRETS_DIR:-$HOME/.dotfiles/sensitive}"
BACKUP_DIR="${BACKUP_DIR:-$HOME/.dotfiles/sensitive/.backups}"

# =============================================================================
# Helper Functions
# =============================================================================
check_age() {
    if ! command -v age &> /dev/null; then
        log_error "age not installed. Install it first:"
        log_error "  make tools"
        exit 1
    fi
}

check_age_key() {
    if [ ! -f "$AGE_KEY_FILE" ]; then
        log_error "Age key not found at: $AGE_KEY_FILE"
        log_error "Generate one with: age-keygen -o $AGE_KEY_FILE"
        exit 1
    fi
}

create_backup() {
    local file="$1"

    if [ ! -f "$file" ]; then
        return 0
    fi

    mkdir -p "$BACKUP_DIR"

    local filename=$(basename "$file")
    local timestamp=$(date +%Y%m%d-%H%M%S)
    local backup_file="$BACKUP_DIR/${filename}.${timestamp}.bak"

    cp "$file" "$backup_file"
    log_success "Backup created: $backup_file"
}

# =============================================================================
# Commands
# =============================================================================
cmd_encrypt() {
    check_age
    check_age_key

    local target_dir="${1:-$SECRETS_DIR}"

    if [ ! -d "$target_dir" ]; then
        log_error "Directory not found: $target_dir"
        exit 1
    fi

    log_info "Encrypting files in: $target_dir"

    local count=0
    for file in "$target_dir"/*.secret; do
        [ -f "$file" ] || continue

        local encrypted="${file}.age"

        # Backup existing encrypted file
        if [ -f "$encrypted" ]; then
            create_backup "$encrypted"
        fi

        # Encrypt
        log_info "Encrypting: $(basename "$file")"
        age -r "$(age-keygen -y "$AGE_KEY_FILE")" -o "$encrypted" "$file"

        ((count++))
    done

    if [ $count -gt 0 ]; then
        log_success "Encrypted $count file(s)"
    else
        log_warning "No *.secret files found to encrypt"
    fi
}

cmd_decrypt() {
    check_age
    check_age_key

    local target_dir="${1:-$SECRETS_DIR}"

    if [ ! -d "$target_dir" ]; then
        log_error "Directory not found: $target_dir"
        exit 1
    fi

    log_info "Decrypting files in: $target_dir"

    local count=0
    for file in "$target_dir"/*.age; do
        [ -f "$file" ] || continue

        local decrypted="${file%.age}"

        # Backup existing decrypted file
        if [ -f "$decrypted" ]; then
            create_backup "$decrypted"
        fi

        # Decrypt
        log_info "Decrypting: $(basename "$file")"
        age -d -i "$AGE_KEY_FILE" -o "$decrypted" "$file"

        ((count++))
    done

    if [ $count -gt 0 ]; then
        log_success "Decrypted $count file(s)"
    else
        log_warning "No *.age files found to decrypt"
    fi
}

cmd_backup() {
    log_info "Creating backup of all encrypted secrets..."

    mkdir -p "$BACKUP_DIR"

    local timestamp=$(date +%Y%m%d-%H%M%S)
    local archive="$BACKUP_DIR/secrets-${timestamp}.tar.gz"

    tar -czf "$archive" -C "$SECRETS_DIR" . --exclude='.backups'

    log_success "Backup created: $archive"
}

cmd_setup_direnv() {
    log_info "Setting up direnv integration..."

    if [ ! -d "$SECRETS_DIR" ]; then
        log_error "Secrets directory not found: $SECRETS_DIR"
        exit 1
    fi

    # Create .envrc template
    local envrc_file="$SECRETS_DIR/.envrc"

    cat > "$envrc_file" << 'EOF'
# Automatically load decrypted .env files
# Run 'direnv allow' to enable

# Load all .env files
for env_file in *.env; do
    if [ -f "$env_file" ]; then
        dotenv "$env_file"
    fi
done

# Or load specific secrets
# export SECRET_KEY=$(cat myservice.api-key.secret 2>/dev/null || echo "")
EOF

    log_success "Created .envrc template: $envrc_file"
    log_info "Edit $envrc_file as needed, then run: direnv allow"
}

cmd_validate() {
    log_info "Validating secrets..."

    local errors=0

    # Check for unencrypted secrets in git
    if git rev-parse --git-dir > /dev/null 2>&1; then
        log_info "Checking for secrets in git..."

        local secrets_in_git=$(git ls-files | grep -E '\.(secret|env)$' | grep -v '.age$' || true)

        if [ -n "$secrets_in_git" ]; then
            log_error "Unencrypted secrets found in git:"
            echo "$secrets_in_git"
            ((errors++))
        else
            log_success "No unencrypted secrets in git"
        fi
    fi

    # Check for orphaned secrets
    log_info "Checking for orphaned files..."

    for secret_file in "$SECRETS_DIR"/*.secret; do
        [ -f "$secret_file" ] || continue

        local encrypted="${secret_file}.age"

        if [ ! -f "$encrypted" ]; then
            log_warning "Unencrypted file without .age version: $(basename "$secret_file")"
        fi
    done

    if [ $errors -eq 0 ]; then
        log_success "Validation passed"
        return 0
    else
        log_error "Validation failed with $errors error(s)"
        return 1
    fi
}

cmd_list() {
    local target_dir="${1:-$SECRETS_DIR}"

    log_info "Secrets in: $target_dir"
    echo ""

    echo "Encrypted files (.age):"
    find "$target_dir" -name "*.age" -type f -exec basename {} \; 2>/dev/null | sort || echo "  (none)"

    echo ""
    echo "Unencrypted files (.secret):"
    find "$target_dir" -name "*.secret" -type f -exec basename {} \; 2>/dev/null | sort || echo "  (none)"
}

# =============================================================================
# Main
# =============================================================================
show_help() {
    cat << EOF
Secrets Management Wrapper

Usage: $(basename "$0") <command> [options]

Commands:
    encrypt [dir]       Encrypt all *.secret files (default: $SECRETS_DIR)
    decrypt [dir]       Decrypt all *.age files (default: $SECRETS_DIR)
    backup              Create tar.gz backup of all encrypted secrets
    setup-direnv        Create .envrc template for direnv integration
    validate            Check for unencrypted secrets in git
    list [dir]          List encrypted and unencrypted secrets
    help                Show this help message

Environment Variables:
    AGE_KEY_FILE        Path to age private key (default: ~/.config/age/key.txt)
    SECRETS_DIR         Secrets directory (default: ~/.dotfiles/sensitive)
    BACKUP_DIR          Backup directory (default: ~/.dotfiles/sensitive/.backups)

Examples:
    $(basename "$0") encrypt                    # Encrypt all secrets
    $(basename "$0") decrypt                    # Decrypt all secrets
    $(basename "$0") encrypt /path/to/secrets   # Encrypt specific directory
    $(basename "$0") backup                     # Create backup
    $(basename "$0") validate                   # Check for secrets in git

EOF
}

main() {
    local command="${1:-help}"

    case "$command" in
        encrypt)
            shift
            cmd_encrypt "$@"
            ;;
        decrypt)
            shift
            cmd_decrypt "$@"
            ;;
        backup)
            cmd_backup
            ;;
        setup-direnv)
            cmd_setup_direnv
            ;;
        validate)
            cmd_validate
            ;;
        list|ls)
            shift
            cmd_list "$@"
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            log_error "Unknown command: $command"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

main "$@"
