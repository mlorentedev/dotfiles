# System files
.DS_Store
Thumbs.db
*.tmp
*.swp
*.swo

# Sensitive data
*.secret
*.dec
.venv/
.env
.env.local
.env.production
.env.development
.env.staging

# Machine-local shell overrides (IDEAS-001) — non-sensitive, per-machine
.zshrc.local
.bashrc.local
.tmux.conf.local

# Cross-machine path resolution (ADR-025). The per-machine override lives at
# ~/.config/dotfiles/machine.json (outside the repo); the generated path files
# are rendered into ~/.dotfiles. Both are ignored here defensively so a stray
# `dotf env generate --output .` or a copied machine.json never gets committed.
# The committed reference is machine.json.example, not machine.json.
/machine.json
/paths.sh
/paths.ps1

# Development tools
node_modules/
*.log

# Go build artifacts — the CLI installs to ~/.local/bin via install-dotf; a local
# `go build` in cli/ leaves an untracked binary that must never be committed.
/cli/dotf
/cli/dotf.exe

# IDE/Editor files
.vscode/
.idea/
*.sublime-*

# Cache directories
.cache/
.npm/
.yarn/

# AI
# .claude/ is deliberately NOT ignored wholesale: CLAUDE.md is this repo's
# project instructions (binding, reviewable, restorable) and belongs in git.
# Only the genuinely machine-local entries are excluded.
.claude/settings.local.json
.claude/worktrees/
.claude/plans/
.gemini/
.ai/
AGY.md
CLAUDE.md
# ...except this repo's own project instructions, which are binding and must be
# versioned, reviewable and restorable. The rule above still catches a deployed
# CLAUDE.md landing at the repo root.
!.claude/CLAUDE.md
.aider*
.antigravitycli/
.antigravitycli.bak/

# Added by ggshield
.cache_ggshield
