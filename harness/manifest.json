{
  "version": 1,
  "vault_subpath": "00_meta/patterns",
  "enforced": [
    { "id": "no-attribution",      "source": "pattern-git-workflow.md#6-attribution-policy" },
    { "id": "english-only",        "source": "pattern-git-workflow.md#8-language-policy" },
    { "id": "no-phase-references", "source": "pattern-git-workflow.md#7-message-content-policy" },
    { "id": "no-auto-merge",       "source": "pattern-git-workflow.md#9-merge-policy" },
    { "id": "definition-of-done",  "source": "pattern-change-lifecycle.md#definition-of-done" },
    { "id": "pr-stewardship",      "source": "pattern-change-lifecycle.md#pr-stewardship" },
    { "id": "secrets-never-in-output", "source": "pattern-secrets-security.md#8-never-print-a-secret" },
    {
      "id": "pr-sizing",
      "source": "pattern-git-workflow.md#10-pr-sizing-policy",
      "opt_out": {
        "AGENTS.md": "the targets region counters harness defaults only; a precedence rule between two of our own rules overrides none, and #824 already states this policy in this file's hand-written prose (#830)",
        "ai/claude/CLAUDE.md": "same as AGENTS.md — the compact doctrine payload substitutes for the constitution agy and codex never receive, and this file's reader already gets the policy from AGENTS.md (#830)"
      }
    }
  ],
  "targets": [
    {
      "agent": "agents",
      "kind": "native",
      "file": "AGENTS.md",
      "inject": ["no-attribution", "english-only", "no-phase-references", "no-auto-merge", "definition-of-done", "pr-stewardship", "secrets-never-in-output"]
    },
    {
      "agent": "claude",
      "kind": "pointer",
      "file": "ai/claude/CLAUDE.md",
      "inject": ["no-attribution", "english-only", "no-phase-references", "no-auto-merge", "definition-of-done", "pr-stewardship", "secrets-never-in-output"]
    }
  ],
  "skills": {
    "vault_subpath": "00_meta/skills",
    "record_dir": "harness/skills",
    "schema": "harness/skill-frontmatter.schema.json",
    "deploy": [
      { "agent": "claude",   "render": "skill",   "dir": ".claude/skills" },
      { "agent": "opencode", "render": "command", "dir": ".config/opencode/commands" },
      { "agent": "agy",      "render": "skill",   "dir": ".gemini/skills" },
      { "agent": "agy",      "render": "prompt",  "dir": ".gemini/prompts" },
      { "agent": "copilot",  "render": "skill",   "dir": ".copilot/skills", "requires_command": "copilot" },
      { "agent": "pi",       "render": "skill",   "dir": ".pi/agent/skills" }
    ],
    "catalog": { "agent": "copilot", "file": ".copilot/copilot-instructions.md" }
  },
  "doctrine": {
    "inject": ["no-attribution", "english-only", "no-phase-references", "no-auto-merge", "definition-of-done", "pr-stewardship", "secrets-never-in-output", "pr-sizing"],
    "deploy": [
      {
        "agent": "agy",
        "file": ".gemini/GEMINI.md",
        "char_cap": 12000,
        "why": "Antigravity reads global rules from ~/.gemini/GEMINI.md and caps EACH rules file at 12000 characters (antigravity.google/docs/rules-workflows). AGENTS.md is 21851 characters, so a full copy cannot be delivered here; this target receives the compact doctrine payload instead. The file is shared with Gemini CLI, so injection is append-and-replace-in-place, never an overwrite."
      },
      {
        "agent": "codex",
        "file": ".codex/AGENTS.md",
        "shadowed_by": ".codex/AGENTS.override.md",
        "char_cap": 32768,
        "why": "Codex reads ~/.codex/AGENTS.md (or AGENTS.override.md in preference) and stops adding files once the global+project chain reaches project_doc_max_bytes, 32 KiB by default (learn.chatgpt.com/docs/agent-configuration/agents-md). A 21851-character global copy would crowd out the repo's own AGENTS.md, which is the more specific file, so this target receives the compact payload."
      }
    ]
  },
  "agents": {
    "vault_subpath": "00_meta/agents/definitions",
    "record_dir": "harness/agents",
    "schema": "harness/agent-frontmatter.schema.json",
    "deploy": [
      { "agent": "claude", "render": "agent-md", "dir": ".claude/agents" }
    ],
    "presence": [
      { "agent": "claude",   "file": ".claude/CLAUDE.md",               "source": "ai/claude/CLAUDE.md" },
      { "agent": "opencode", "file": ".config/opencode/AGENTS.md",      "source": "AGENTS.md" },
      { "agent": "pi",       "file": ".pi/agent/AGENTS.md",             "source": "AGENTS.md" },
      { "agent": "copilot",  "file": ".copilot/copilot-instructions.md", "source": "ai/copilot/copilot-instructions.md", "requires_command": "copilot" }
    ]
  }
}
