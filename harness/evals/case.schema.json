{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlorentedev.github.io/dotfiles/evals/case.schema.json",
  "title": "dotf eval case",
  "description": "One evaluation case and its anchor-encoded answer key (ADR-063 §1). A replay case replays an archived spec review at its reviewed_sha; a planted case carries a prompt with known defects.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "repo", "kind", "role", "key_author", "expected_verdict", "expected", "optional", "decoys", "noise"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "kind": { "enum": ["replay", "planted"] },
    "role": { "enum": ["spec-reviewer"] },
    "spec": { "type": "string", "minLength": 1 },
    "source_review": { "$ref": "#/$defs/path" },
    "prompt": { "$ref": "#/$defs/path" },
    "reference_answer": { "$ref": "#/$defs/path" },
    "key_author": { "type": "string", "minLength": 1 },
    "reviewed_sha": { "$ref": "#/$defs/sha" },
    "base_sha": { "$ref": "#/$defs/sha" },
    "base_derivation": { "type": "string", "minLength": 1 },
    "fetch_ref": { "type": "string", "pattern": "^refs/" },
    "expected_verdict": { "enum": ["PASS", "PASS-WITH-GAPS", "FAIL"] },
    "expected": { "type": "array", "items": { "$ref": "#/$defs/confirmed" } },
    "optional": { "type": "array", "items": { "$ref": "#/$defs/unconfirmed" } },
    "decoys": { "type": "array", "items": { "$ref": "#/$defs/sampled" } },
    "noise": { "type": "array", "items": { "$ref": "#/$defs/sampled" } }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "replay" } } },
      "then": {
        "required": ["spec", "source_review", "reviewed_sha", "base_sha", "base_derivation"],
        "properties": { "expected": { "minItems": 1 } }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "planted" } } },
      "then": {
        "required": ["prompt", "reference_answer"],
        "properties": { "expected": { "minItems": 1 } }
      }
    }
  ],
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "path": { "type": "string", "pattern": "^[^/\\\\][^\\\\]*$", "minLength": 1 },
    "anchor": { "type": "string", "pattern": "\\S" },
    "severity": { "enum": ["Blocker", "Major", "Minor"] },
    "anchors": {
      "type": "object",
      "required": ["id", "anchors_all"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "anchors_all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/anchor" } },
        "anchors_any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/anchor" } }
      }
    },
    "confirmed": {
      "description": "A finding a later commit fixed, verification.md dispositioned as real, or the owner adjudicated.",
      "allOf": [{ "$ref": "#/$defs/anchors" }],
      "required": ["severity_floor", "confirmed_by"],
      "unevaluatedProperties": false,
      "properties": {
        "severity_floor": { "$ref": "#/$defs/severity" },
        "confirmed_by": { "type": "string", "minLength": 1 }
      }
    },
    "unconfirmed": {
      "description": "A finding labelled REAL by its reviewer but never confirmed, or one the replayed tree already dispositions. Matching earns credit; missing costs nothing.",
      "allOf": [{ "$ref": "#/$defs/anchors" }],
      "unevaluatedProperties": false,
      "properties": {
        "severity_floor": { "$ref": "#/$defs/severity" },
        "note": { "type": "string" }
      }
    },
    "sampled": {
      "description": "A decoy (a claim known to be false) or a noise pattern (a trace of the replay environment). The sample is a recorded row the anchors must match, so a dead anchor fails the check.",
      "allOf": [{ "$ref": "#/$defs/anchors" }],
      "required": ["reason", "sample"],
      "unevaluatedProperties": false,
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "sample": { "type": "string", "pattern": "\\S" }
      }
    }
  }
}
