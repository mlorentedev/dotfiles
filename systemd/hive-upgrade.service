[Unit]
Description=Upgrade hive-vault to the latest PyPI release
Documentation=https://github.com/mlorentedev/hive/issues/176

[Service]
Type=oneshot
# uv comes from mise (setup's `dotf tools sync`, #2013 W2), reached through its
# shims dir; a box set up before that has it in ~/.local/bin from uv's own
# installer. A --user oneshot gets a minimal PATH that has neither, so the unit
# declares both, shims first as `mise activate` orders them, and resolves uv
# through env. %h resolves to the user home.
# uv tool upgrade exits 0 when already current, so the oneshot is not marked failed.
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env uv tool upgrade hive-vault
