# ~/.bashrc.local — machine-local bash overrides (IDEAS-001).
#
# Copy to ~/.bashrc.local and uncomment what you need. This file is gitignored
# and sourced LAST by .bashrc, so it can override aliases/exports/prompt above.
#
# NON-SENSITIVE config only. Secrets (API keys, tokens) belong in the age system
# (sensitive/*.secret.age + sensitive/env-mapping.conf), NEVER here.

# Host-specific PATH prepend (a tool installed by hand on this box only):
# export PATH="$HOME/Applications/some-tool/bin:$PATH"

# VM- or laptop-only alias:
# alias k=kubectl

# Work-only, non-secret environment variable:
# export HTTP_PROXY="http://proxy.corp.local:8080"

# Unlock a passphrase-protected SSH key once per boot via a userspace ssh-agent
# (for boxes where the OS ssh-agent service isn't available, e.g. non-admin
# Windows where the ssh-agent service is admin-gated). The key is reused across
# Git Bash sessions, so you type the passphrase once per boot. Serves Git Bash's
# ssh, not the Windows ssh.exe in PowerShell. Uncomment to enable on this box:
# _ssh_key="$HOME/.ssh/id_ed25519"
# if [ -f "$_ssh_key" ]; then
#     _agent_env="$HOME/.ssh/agent.env"
#     [ -f "$_agent_env" ] && . "$_agent_env" >/dev/null
#     ssh-add -l >/dev/null 2>&1; _state=$?      # 0=has keys 1=no keys 2=no agent
#     if [ "$_state" -eq 2 ]; then
#         (umask 077; ssh-agent -s >"$_agent_env"); . "$_agent_env" >/dev/null
#         ssh-add "$_ssh_key"
#     elif [ "$_state" -eq 1 ]; then
#         ssh-add "$_ssh_key"
#     fi
#     unset _agent_env _state
# fi
# unset _ssh_key
