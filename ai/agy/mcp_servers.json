{
  "mcpServers": {
    "hive-vault": {
      "command": "uvx",
      "args": [
        "hive-vault"
      ],
      "env": {
        "VAULT_PATH": "${VAULT_PATH}",
        "HIVE_OLLAMA_ENDPOINT": "http://ollama.kubelab.live:11434",
        "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}"
      },
      "timeout": 30000,
      "trust": false
    }
  }
}
