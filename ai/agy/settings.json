{
  "allowNonWorkspaceAccess": true,
  "model": "Gemini 3.7 Flash (High)",
  "notifications": true,
  "permissions": {
    "allow": [
      "command(*)",
      "read_file(*)",
      "write_file(*)",
      "read_url(*)",
      "search_web(*)"
    ],
    "deny": [
      "command(rm -rf /)",
      "command(rm -rf ~/*)"
    ]
  },
  "trustedWorkspaces": [
    "/home/manu/Projects/*",
    "C:/Users/mlorente/Projects/*",
    "C:/Users/mlorente/Projects/Workspace/*"
  ],
  "workspace": {
    "autoSave": true,
    "excludePatterns": [
      "**/node_modules/**",
      "**/.git/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.pydantic_cache/**",
      "**/.pytest_cache/**",
      "**/.mypy_cache/**",
      "**/.ruff_cache/**",
      "**/.venv/**",
      "**/__pycache__/**",
      "**/.cache/**",
      "**/coverage/**",
      "**/htmlcov/**",
      "**/.astro/**",
      "**/.worktrees/**",
      "**/.ansible/**",
      "**/.terraform/**",
      "**/.gemini/**",
      "**/.antigravitycli/**",
      "**/specs/**/review-transcript.jsonl*"
    ],
    "maxFileSizeMB": 15
  },
  "safety": {
    "toolPermission": "always-proceed",
    "sandboxMode": false,
    "dangerouslySkipPermissions": false
  },
  "modelConfigs": {
    "defaultModel": "gemini-3.7-flash",
    "customAliases": {
      "chat-base": {
        "modelConfig": {
          "generateContentConfig": {
            "temperature": 0.7,
            "topP": 0.95,
            "topK": 40,
            "thinkingConfig": {
              "thinkingLevel": "HIGH"
            }
          }
        }
      },
      "deep-think": {
        "modelConfig": {
          "generateContentConfig": {
            "temperature": 0.2,
            "topP": 0.95,
            "thinkingConfig": {
              "thinkingLevel": "HIGH"
            }
          }
        }
      }
    }
  },
  "context": {
    "fileName": [
      "AGENTS.md",
      "AGY.md"
    ],
    "autoLoadContext": true,
    "maxContextTokens": 2000000
  },
  "performance": {
    "streamResponses": true,
    "showThinkingSteps": true,
    "keep_thinking": false,
    "networkTimeoutMs": 60000,
    "maxRetries": 2,
    "maxConcurrentSubagents": 6,
    "telemetryEnabled": false
  },
  "ui": {
    "showMemoryUsage": false,
    "theme": "GitHub",
    "verbosity": "normal"
  }
}