{
  "model": "claude-3-5-sonnet-20241022",
  "max_tokens": 8192,
  "temperature": 0.1,
  "top_p": 0.95,
  "context_window": 200000,
  "auto_approve": false,
  "diff_format": "unified",
  "file_watch": true,
  "auto_lint": true,
  "auto_format": true,
  "test_on_save": true,
  "context_files": [
    "**/*.md",
    "**/*.yaml",
    "**/*.yml",
    "**/Dockerfile*",
    "**/*.tf",
    ".env.example"
  ],
  "ignore_patterns": [
    "**/node_modules/**",
    "**/__pycache__/**",
    "**/.git/**",
    "**/dist/**",
    "**/build/**",
    "**/*.pyc",
    "**/.DS_Store"
  ],
  "custom_instructions": "Follow CLAUDE.md protocol strictly. Code-first responses. Zero explanations.",
  "workspace_context": true,
  "multi_file_edit": true,
  "parallel_processing": true,
  "cache_embeddings": true,
  "stream_output": true,
    "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(chmod:*)",
      "Bash(source:*)",
      "Bash(log_info \"Testing utils.sh\")",
      "Bash(log_success \"Utils loaded successfully\")",
      "Bash(log_warning:*)",
      "Bash(./age-encrypt-decrypt.sh:*)",
      "Bash(./scripts/age-encrypt-decrypt.sh:*)",
      "Bash(./scripts/install-precommit.sh:*)",
      "Bash(bash scripts/install-precommit.sh:*)"
    ],
    "deny": [],
    "ask": []
  }
}