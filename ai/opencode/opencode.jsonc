// OpenCode configuration — managed by dotfiles.
//
// SSOT: ai/opencode/opencode.jsonc (this file).
// Deploy target: ~/.config/opencode/opencode.jsonc (via setup-linux.sh / setup-windows.ps1).
// Schema: https://opencode.ai/config.json
// Spec: specs/SDD-007-ai-tooling-consolidation/ (NaN default + drop Go + drop legacy gemini-cli + drop aider).
// Historical context: specs/archive/AI-011-opencode-bootstrap/ (initial bootstrap, 2026-05-17).
//
// Model Tier (per AGENTS.md "Model Selection") — post-SDD-007:
//   Default: nan/qwen3.6                — 256K, multimodal, FAST (~0.8s wall, 0 reasoning tokens)
//   On-demand long-context: nan/deepseek-v4-flash  — 1M context, but ~3s wall + 30+ reasoning
//                                                    tokens per call. Use only when 256K is not enough.
//   A/B:     nan/gemma4                 — multimodal alternative vs qwen3.6 (256K, ~0.7s wall).
// Empirical (scripts/nan-bench.sh): deepseek-v4-flash is 4x slower than qwen3.6 even
// for trivial prompts due to mandatory reasoning chain. Default chosen by latency.
//   Embeddings / Audio: qwen3-embedding, kokoro (TTS), whisper (STT) — exposed for
//                       cluster completeness; not chat-routable (use curl / OpenAI SDK directly).
//   Frontier on-demand: openrouter/* (PAYG, uses existing $5 credit) — Opus / Sonnet / GPT-4
//   Local:   ollama (homelab/VPN endpoint, user-managed in separate session)
// Selection: TUI `/models` picker. Wrappers `qq` (nan/qwen3.6) / `qf` (nan/deepseek-v4-flash)
//            in .zsh/aliases.zsh + .bashrc + powershell/profile.ps1.
{
  "$schema": "https://opencode.ai/config.json",
  // Performance tuning (2026-05-27): lsp and snapshot disabled to reduce memory
  // footprint and startup time; snapshot disables undo-tracking internal git repo.
  "lsp": false,
  "snapshot": false,
  "instructions": ["{env:HOME}/.config/opencode/AGENTS.md"],
  // Explicit fast model for title generation — avoids fallback delay.
  "small_model": "nan/qwen3.6",
  "model": "nan/deepseek-v4-flash",

  "provider": {
    // NaN community — primary daily provider.
    // API key: $NAN_API_KEY (sensitive/nan.api-key.secret.age, exported by load-secrets.sh).
    "nan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NaN",
      "options": {
        "baseURL": "https://api.nan.builders/v1",
        "apiKey": "{env:NAN_API_KEY}",
        "model": "qwen3.6",
        // Reduced from 300s default — NaN is fast, fail fast on network issues.
        "timeout": 60000,
        // Reduced from 30s default — qwen3.6 streams quickly.
        "chunkTimeout": 10000
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (DeepSeek - 1M)",
          // Surface NaN's reasoning chain in the TUI. NaN streams it in the
          // non-standard `reasoning_content` field (a DeepSeek/Qwen alias), which
          // @ai-sdk/openai-compatible drops by default. `interleaved` maps it to a
          // reasoning part opencode can render (schema-verified on opencode 1.15.13).
          // Toggle visibility with ctrl+o or `/thinking` (see ai/opencode/tui.json).
          // NaN's other field, `provider_specific_fields.reasoning`, is NOT in the
          // enum, so we map reasoning_content. Out-of-TUI fallback: the `dbg` alias
          // (scripts/nan-debug.sh) curls NaN directly and prints reasoning + answer.
          "interleaved": { "field": "reasoning_content" },
          "limit": {
            "context": 1000000,
            "output": 8192
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "options": {
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          },
          "variants": {
            "fast": {
              "chat_template_kwargs": {
                "enable_thinking": false
              }
            },
            "thinking": {
              "chat_template_kwargs": {
                "enable_thinking": true
              }
            }
          }
        },
        "qwen3.6": {
          "name": "Qwen 3.6 (Alibaba - 256K)",
          // Surface reasoning in the TUI (see deepseek-v4-flash note).
          "interleaved": { "field": "reasoning_content" },
          "limit": {
            "context": 256000,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "options": {
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          },
          "variants": {
            "fast": {
              "chat_template_kwargs": {
                "enable_thinking": false
              }
            },
            "thinking": {
              "chat_template_kwargs": {
                "enable_thinking": true
              }
            }
          }
        },
        "gemma4": {
          "name": "Gemma 4 (Google - 256K)",
          // Surface reasoning in the TUI (see deepseek-v4-flash note).
          "interleaved": { "field": "reasoning_content" },
          "limit": {
            "context": 256000,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
                    "options": {
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          },
          "variants": {
            "fast": {
              "chat_template_kwargs": {
                "enable_thinking": false
              }
            },
            "thinking": {
              "chat_template_kwargs": {
                "enable_thinking": true
              }
            }
          }
        },
        "mimo-v2.5": {
          "name": "MiMo V2.5 (Xiaomi - 1M)",
          // Surface reasoning in the TUI (see deepseek-v4-flash note).
          "interleaved": { "field": "reasoning_content" },
          "limit": {
            "context": 1000000,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image", "audio"],
            "output": ["text"]
          },
                  "options": {
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          },
          "variants": {
            "fast": {
              "chat_template_kwargs": {
                "enable_thinking": false
              }
            },
            "thinking": {
              "chat_template_kwargs": {
                "enable_thinking": true
              }
            }
          }
        }
        // Non-chat NaN models (qwen3-embedding, kokoro TTS, whisper STT) are
        // intentionally NOT listed here: opencode's modality schema only allows
        // {text, audio, image, video, pdf} as output values; "embedding" is
        // rejected and a single invalid entry breaks ALL provider loading.
        // Access them directly via curl / OpenAI SDK — see ai/nan/README.md.
      }
    },

    // OpenRouter — frontier on-demand fallback (PAYG, existing $5 credit).
    // No models override → uses OpenRouter's preloaded catalog; interactive picker.
    "openrouter": {},

    // (compaction block sits at top level — see below the provider block)

    // Ollama — homelab endpoint (VPN-only). User wires the API key as a secret
    // (sensitive/ollama.api-key.secret.age, mapping line in env-mapping.conf
    // commented until the file exists). Model list intentionally empty — user
    // adds models as they pull them on the homelab side; opencode discovers via
    // /v1/models when the endpoint is reachable.
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (homelab via VPN)",
      "options": {
        "baseURL": "https://ollama.kubelab.live/v1",
        "apiKey": "{env:OLLAMA_API_KEY}"
      }
    }
  },

  // Context compaction — NaN-recommended block (https://nan.builders/docs/examples).
  // Critical for the 1M-context default model: opencode auto-compacts when the
  // session approaches the model's context window, prunes old tool outputs, and
  // reserves a buffer so compaction itself has room to run.
  //   auto:     true   — auto-compact when context is full
  //   prune:    true   — remove old tool outputs to save tokens
  //   reserved: 50000  — token buffer to avoid overflow during compaction
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 50000
  },

  // MCP servers — mirror of mcp-servers.json (Claude Code SSOT).
  // 2026-05-25 cleanup: removed `drawio` (rarely used, spawned subprocess
  // even with --pure) and `socket` (mcp.socket.dev hung 30s+ on tool
  // discovery). Keep only hive + context7 + sequential-thinking across all
  // environments (Claude Code / opencode / agy).
  // Coexistence constraint: do not run `oc` and `claude` in parallel on
  // the same repo until hive MCP adds a lock-file to auto-commit.
  // File watcher — skip noisy directories to reduce I/O.
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", "*.log", "build/**"]
  },
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      // Prevent indefinite hangs on tool discovery.
      "timeout": 3000
    },
    "hive": {
      "type": "local",
      "command": ["uvx", "hive-vault"],
      "enabled": true
    }
  }
}
